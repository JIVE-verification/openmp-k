sub main {
     @originalArgv = @ARGV;
     $args->parse() or die "Failed to parse the command line.\n";

     if (!$args->{'-s'}) {
       push(@stdlib, 'c');
     }

     my $heapSize = "2G";
     if ($args->{'-Xmx'}) {
          $heapSize = $args->{'-Xmx'};
     }

     # Set heap and stack size of krun
     $ENV{K_OPTS} = "-Xms64m -Xmx$heapSize -Xss32m -XX:+TieredCompilation";

     if ($args->{'-E'}) {
          return preprocess($args->{'-o'}. @{$args->{'<files>'}});
     }

     if ($args->{'-c'}) {
          compile($args->{'-o'}, @{$args->{'<files>'}});
          return 0;
     }

     if ($args->{'-shared'}) {
          classify(@{$args->{'<files>'}});
          mergeObjs(1, 0);
          move($objFiles[0], $args->{'-o'} || 'a.out');
          return 0;
     }

     if ($args->{'-s'}) {
          classify(@{$args->{'<files>'}});
     } else {
          classify(@{$args->{'<files>'}}, catfile($myDirectory, 'lib', 'libc.so'));
     }

     # Reduce our objFiles down to at most two.
     mergeObjs(2, 1);
     # my $oval = $args->{'-o'} || 'a.out';
     my $input_file = $srcFiles[0];
     my $target_file_dir =$srcFiles[0];
     # $target_file_dir =~ s/\.c$//;
     $target_file_dir ="experiments/trans-".$target_file_dir;

     if (!-d $target_file_dir) {
          print "$target_file_dir Creating..\n";
          make_path($target_file_dir) or die "Cannot create $target_file_dir: $!";
     }
     my $programConfFile = File::Temp->new( 
                TEMPLATE => 'tmp-kcc-out-XXXXXXX', 
                SUFFIX => '.txt',
                UNLINK => 0 );
     push(@tempFiles, $programConfFile);
     # At this point, we have 0-1 source files and 0-2 object files left for
     # the final call(s) to kcc. Setting up the arguments is kinda difficult
     # because we need to use different parsers if one of the config vars
     # should be empty.
     # my $retval = execute('krun', getKRunCommand($programConfFile, $objFiles[0], $objFiles[1], $srcFiles[0], 1));
     my $cmd = "$KRUN " . join(" ", getKRunCommandPretty($programConfFile, $objFiles[0], $objFiles[1], $srcFiles[0], 1, $args->{'--depth'}));
     print $cmd . "\n" if ($args->{'-d'});
     my $retval = system($cmd);     

     my $output_file_path = $target_file_dir. "/". $input_file;
     if(defined $args->{'--depth'}){
          $output_file_path .= "-".$args->{'--depth'}.".txt";
     }
     else{
          $output_file_path .= ".txt";
     }
     copy($programConfFile, $output_file_path) or die "Pretty Config failed: $!";
     # print("krun return value <O means OK, !0 means Error> is $retval\n");     
     return 0;
}

