typedef struct {
    int thread_id;
    int repeat;
    int *shared_total;
    mtx_t *lock;
} worker_args;

static int worker(void *arg) {
    worker_args *data = (worker_args *)arg;

    for (int i = 0; i < data->repeat; ++i) {
        if (mtx_lock(data->lock) != thrd_success) {
            puts("mtx_lock failed");
            return thrd_error;
        }
        *data->shared_total += data->thread_id;
        if (mtx_unlock(data->lock) != thrd_success) {
            puts("mtx_unlock failed");
            return thrd_error;
        }
    }

    printf("thread %d finished work\n", data->thread_id);
    return data->thread_id * data->repeat;
}

int main(void) {
    enum { THREAD_COUNT = 3 };
    thrd_t threads[THREAD_COUNT];
    worker_args args[THREAD_COUNT];
    mtx_t lock;
    int total = 0;

    if (mtx_init(&lock, mtx_plain) != thrd_success) {
        puts("mtx_init failed");
        return 1;
    }

    for (int i = 0; i < THREAD_COUNT; ++i) {
        args[i].thread_id = i + 1;
        args[i].repeat = 4;
        args[i].shared_total = &total;
        args[i].lock = &lock;

        if (thrd_create(&threads[i], worker, &args[i]) != thrd_success) {
            puts("thrd_create failed");
            return 1;
        }
    }

    for (int i = 0; i < THREAD_COUNT; ++i) {
        int result = 0;
        if (thrd_join(threads[i], &result) != thrd_success) {
            puts("thrd_join failed");
            return 1;
        }
        printf("thread %d returned %d\n", i + 1, result);
    }

    printf("final shared total = %d\n", total);
    return 0;
}
