#!/bin/bash

SIMPLE_K_FILE="simple-typed-dynamic.k"
PROJECT_DIR="dist/k/tutorial/2_languages/1_simple/2_typed/2_dynamic/"

echo "$SIMPLE_K_FILE"

cp -f "$SIMPLE_K_FILE" "$PROJECT_DIR"

