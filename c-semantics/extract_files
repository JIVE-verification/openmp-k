#!/bin/bash

# Usage:
# ./copy_matching_c_files.sh "pattern1" "pattern2" /path/to/search /path/to/destination

PATTERN1="#pragma omp parallel for private"
PATTERN2="for"
SEARCH_DIR="$1"
DEST_DIR="example_dir"

mkdir -p "$DEST_DIR"

grep -rl -E --include="*.c" "$PATTERN1" "$SEARCH_DIR" | while read -r file; do
    if grep -q "$PATTERN2" "$file"; then
        cp "$file" "$DEST_DIR"
#	echo "$file"
    fi
done
